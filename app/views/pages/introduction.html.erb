<div class="py-5 text-white text-center space-y-10">
  <div class="flex-col md:flex items-center justify-center">
    <div class="fade-up">
      <%= image_tag 'About.png', class: "h-[500px] w-auto" %>
    </div>
    <div class="flex flex-col items-center justify-center">
      <div class="text-5xl space-y-5 slide-in-left">
        <div>目指すのは</div>
        <div>社会人一年目に<br>欲しかったモノ</div>
      </div>
      <div class="mt-10 fade-up">
        <%= image_tag 'About-1.png' %>
      </div>
    </div>
  </div>
  <div class="flex flex-col items-center justify-center">
